# ─── Database ────────────────────────────────────────────────────────────────
# Path to the SQLite database file used by Prisma.
# For local dev, use a relative path (e.g. file:./prisma/dev.db).
# In Docker / production the app writes to /app/prisma/dev.db inside the container.
PRISMA_DB_URL="file:./prisma/dev.db"

# ─── Discord Bot ─────────────────────────────────────────────────────────────
# Credentials for the Discord bot integration.
# Docs: https://discord.com/developers/docs/quick-start/getting-started
#   TOKEN   – Bot token from the Discord Developer Portal → Bot → "Reset Token"
#   GUILD_ID – Server (Guild) ID: right-click your server icon → Copy Server ID
#   BOT_ID  – Application/Client ID from Developer Portal → General Information
TOKEN="EXAMPLE_DISCORD_BOT_TOKEN"
GUILD_ID="EXAMPLE_DISCORD_GUILD_ID"
BOT_ID="EXAMPLE_DISCORD_BOT_ID"

# ─── GitHub Integration (Optional) ───────────────────────────────────────────
# Personal Access Token with repo/org read permissions.
# Generate at: https://github.com/settings/tokens
# Set GITHUB_MANAGER_CLI=true to enable automatic repo management via the CLI.
GITHUB_TOKEN="EXAMPLE_GITHUB_PAT"
GITHUB_MANAGER_CLI="false"
