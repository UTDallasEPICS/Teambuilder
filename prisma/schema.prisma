generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("PRISMA_DB_URL")
}

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          String      @default("user")
  whitelisted   Boolean     @default(false)
  removed       Boolean     @default(false)

  sessions      BaSession[]
  accounts      BaAccount[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("users")
}

model BaSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ba_sessions")
}

model BaAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ba_accounts")
}

model BaVerification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ba_verifications")
}

model Partner {
  id           String    @id @default(uuid())
  name         String
  contactName  String    @map("contact_name")
  contactEmail String    @map("contact_email")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@map("partners")
}

model Project {
  id          String             @id @default(uuid())
  name        String
  description String
  type        ProjectType
  status      ProjectStatus
  repoURL     String             @map("repo_url")
  partnerId   String             @map("partner_id")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  meetingDay  ProjectMeetingDay? @map("meeting_day")
  choices     Choice[]
  partner     Partner            @relation(fields: [partnerId], references: [id])
  teams       Team[]

  @@map("projects")
}

model Team {
  id         String            @id @default(uuid())
  projectId  String            @map("project_id")
  semesterId String            @map("semester_id")
  meetingDay ProjectMeetingDay @default(THURSDAY) @map("meeting_day")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  semester   Semester          @relation(fields: [semesterId], references: [id])
  project    Project           @relation(fields: [projectId], references: [id])
  students   Student[]         @relation("StudentToTeam")

  @@unique([projectId, semesterId, meetingDay])
  @@map("teams")
}

model Student {
  id         String             @id @default(uuid())
  github     String?            @unique
  discord    String?            @unique
  email      String?            @unique
  netID      String             @unique @map("net_id")
  firstName  String             @map("first_name")
  lastName   String             @map("last_name")
  major      String
  year       Year
  class      String
  enrollment String?
  status     StudentStatus
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  meetingDay ProjectMeetingDay? @map("meeting_day")
  choices    Choice[]
  teams      Team[]             @relation("StudentToTeam")

  @@map("students")
}

model Choice {
  id        String   @id @default(uuid())
  rank      Int
  studentId String   @map("student_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@map("choices")
}

model Semester {
  id        String   @id @default(uuid())
  year      Int
  season    Season
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teams     Team[]

  @@unique([year, season])
  @@map("semesters")
}

enum Year {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR
}

enum Season {
  SPRING
  SUMMER
  FALL
}

enum ProjectType {
  SOFTWARE
  HARDWARE
  BOTH
}

enum ProjectStatus {
  NEW
  RETURNING
  COMPLETE
  WITHDRAWN
  HOLD
}

enum ProjectMeetingDay {
  WEDNESDAY
  THURSDAY
  BOTH
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}